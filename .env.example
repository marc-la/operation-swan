# Copy to .env and fill in. NEVER commit .env (rules §5.6).
# Team code: community portal -> Team page. 16 chars. It is both the registration key
# and the competition-LLM API key. Share with teammates privately only.
CTN_TEAM_CODE=

# Your team's assigned side, from the team page: "Vote Yes" or "Vote No"
CTN_SIDE=

# Who runs this machine's bots, for attribution in our logs (default: marc)
# CTN_OPERATOR=

# External LLMs for content generation (rules §5.1). The bot tries deploy/llm_chain.txt in order and
# skips any provider whose key is unset; providers and keys are listed in src/swan_bot/llm.py PROVIDERS.
# Each provider also takes <PROVIDER>_MODEL (comma-separated) to override its default models.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ALIBABA_API_KEY=
# BEDROCK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# LLM_CHAIN=                 # provider:model,provider:model ... overrides deploy/llm_chain.txt
# LLM_RPM=                   # requests a minute across the chain

# NPC lab's stand-in citizen: an OpenAI-compatible qwen2.5-3b endpoint (deploy/modal_qwen.py serves one)
# LAB_REMOTE_URL=            # ending in /v1
# LAB_REMOTE_KEY=

# scripts/aws_cost.py only: read-only billing access for the EC2 account
# EC2_ACCESS_KEY=
# EC2_SECRET_ACCESS_KEY=
# AWS_CREDIT_USD=200
