<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<noscript><meta http-equiv="refresh" content="60"></noscript>
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>Swan · Lab</title>
<style>
:root {
  --bg: #f6f6f4; --card: #ffffff; --ink: #1d1d1b; --muted: #6b6b66; --line: #e3e3de;
  --green: #1f7a4d; --green-bg: #e3f3ea; --amber: #8a5a00; --amber-bg: #fdf0d5; --red: #a12622; --red-bg: #fbe2e0;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161615; --card: #1f1f1d; --ink: #ecece8; --muted: #9a9a93; --line: #33332f;
    --green: #6fd29d; --green-bg: #173326; --amber: #f2c063; --amber-bg: #3a2c10; --red: #ff8a83; --red-bg: #41191a;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink);
  font: 15px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-variant-numeric: tabular-nums; }
main { max-width: 1000px; margin: 0 auto; padding: 16px; }
header { display: flex; justify-content: space-between; align-items: baseline; color: var(--muted); font-size: 13px; }
header b { color: var(--ink); letter-spacing: .08em; }
a { color: inherit; }
.sub { color: var(--muted); font-size: 13px; }
.note { margin: 10px 0 16px; padding: 12px 14px; border-radius: 10px; background: var(--card); border: 1px solid var(--line); }
.amber { background: var(--amber-bg); color: var(--amber); border-color: transparent; }
h2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 24px 0 8px; }
.wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 6px 8px; text-align: right; border-top: 1px solid var(--line); white-space: nowrap; }
th { font-weight: 600; font-size: 12px; color: var(--muted); border-top: 0; }
td:first-child, th:first-child { text-align: left; }
.up { color: var(--green); font-weight: 600; } .down { color: var(--red); font-weight: 600; }
details { margin: 6px 0; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
summary { padding: 8px 12px; cursor: pointer; }
.ex { padding: 8px 12px; border-top: 1px solid var(--line); }
.ex p { margin: 3px 0; overflow-wrap: anywhere; }
.ex .k { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; margin-right: 6px; }
</style>
</head>
<body>
<main>
<header><span><b>SWAN</b> · NPC lab</span><span><a href="index.html">← dashboard</a> · built {{ built }} Perth</span></header>

<div class="note {{ 'amber' if down else '' }}">
  {% if down %}The stand-in is down ({{ down }}): the lab waits and starts again on its own.{% else %}
  Stand-in now: <b>{{ lab_model or "—" }}</b> · {{ queued if queued is not none else "—" }} trials queued.{% endif %}
  {{ personas }} persona cards ({% for c in classes %}{{ c }} {{ per_class.get(c, 0) }}{{ ", " if not loop.last }}{% endfor %}),
  {{ strategies | length }} strategies.
  <div class="sub">A proxy: a stand-in citizen on the organisers' model family reads one reply. Live results decide.
  Add a strategy with one file in <code>content/lab/strategies/</code> (docs/06-strategy/npc-lab.md).</div>
</div>

{% for m in models %}
<h2>Stand-in {{ m.model }} · {{ m.trials }} trials · Control net {{ m.control if m.control is not none else "—" }}</h2>
<div class="wrap"><table>
<tr><th>strategy</th><th>trials</th><th>toward No</th><th>same</th><th>toward Yes</th><th>net No−Yes</th><th>vs Control</th>
{% for c in classes %}<th>{{ c }}</th>{% endfor %}</tr>
{% for t in m.table %}
<tr><td>{{ t.name }}</td><td>{{ t.n }}</td><td>{{ t.no }}</td><td>{{ t.same }}</td><td>{{ t.yes }}</td>
<td class="{{ 'up' if (t.net or 0) > 0 else 'down' if (t.net or 0) < 0 else '' }}">{{ t.net if t.net is not none else "—" }}</td>
<td class="{{ 'up' if (t.vs or 0) > 0 else 'down' if (t.vs or 0) < 0 else '' }}">{{ "%+d" % t.vs if t.vs is not none else "—" }}</td>
{% for c in classes %}<td>{{ t.by_class[c] if t.by_class[c] is not none else "" }}</td>{% endfor %}</tr>
{% endfor %}
</table></div>
<div class="sub">Per 100 trials. Class columns: net toward No minus toward Yes for that stance class. With ~2 trials per cell, read the totals first.</div>

{% for t in m.table %}
<details><summary><b>{{ t.name }}</b> · {{ t.author }} · {{ t.notes }}</summary>
{% for e in t.examples %}
<div class="ex">
  <p><span class="k">{{ e.cls }}</span>{{ e.them }}</p>
  <p><span class="k">{{ e.voice or "control" }}</span>{{ e.reply }}</p>
  <p><span class="k">after</span>{{ e.after }}</p>
  <p><span class="k">verdict</span><b>{{ e.verdict }}</b></p>
</div>
{% endfor %}
</details>
{% endfor %}
{% else %}
<div class="note">No trials yet.</div>
{% endfor %}

<h2>Strategies</h2>
<div class="wrap"><table>
<tr><th>strategy</th><th>author</th><th>priority</th><th>skipped drafts</th></tr>
{% for s in strategies %}<tr><td>{{ s.name }}</td><td>{{ s.author }}</td><td>{{ s.priority }}</td><td>{{ s.skipped }}</td></tr>{% endfor %}
</table></div>
</main>
</body>
</html>
