<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<noscript><meta http-equiv="refresh" content="60"></noscript>
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>Swan · {{ status_word }}</title>
<script src="app.js" defer></script>
<style>
:root {
  --bg: #f6f6f4; --card: #ffffff; --ink: #1d1d1b; --muted: #6b6b66; --line: #e3e3de;
  --green: #1f7a4d; --green-bg: #e3f3ea; --amber: #8a5a00; --amber-bg: #fdf0d5; --red: #a12622; --red-bg: #fbe2e0;
  --orange: #8f3f00; --orange-bg: #ffe2c6; --blue: #0b4f8a; --blue-bg: #e1eefb; --ored: #b03a12; --ored-bg: #fdebe3;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161615; --card: #1f1f1d; --ink: #ecece8; --muted: #9a9a93; --line: #33332f;
    --green: #6fd29d; --green-bg: #173326; --amber: #f2c063; --amber-bg: #3a2c10; --red: #ff8a83; --red-bg: #41191a;
    --orange: #ffb070; --orange-bg: #3d2410; --blue: #8cc4ff; --blue-bg: #132a40; --ored: #ff9b73; --ored-bg: #3b1d12;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink);
  font: 15px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-variant-numeric: tabular-nums; }
main { max-width: 900px; margin: 0 auto; padding: 16px; }
header { display: flex; justify-content: space-between; align-items: baseline; color: var(--muted); font-size: 13px; }
header b { color: var(--ink); letter-spacing: .08em; }
.banner { margin: 10px 0 16px; padding: 14px 16px; border-radius: 10px; font-weight: 600; font-size: 17px; }
.banner::before { content: "●  "; }
.chips { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
.chip { padding: 1px 9px; border-radius: 99px; font-size: 12px; font-weight: 600; white-space: nowrap; }
.chip::before { content: "● "; }
.chip.grey { background: var(--card); color: var(--muted); border: 1px solid var(--line); }
.alerts { margin: 8px 0 0; }
.alerts p { margin: 3px 0; padding: 5px 10px; border-radius: 8px; font-size: 13px; }
.alerts details { margin: 3px 0; padding: 5px 10px; border: 0; border-radius: 8px; font-size: 13px; }
.alerts details div { margin-top: 4px; }
.alerts details > summary { padding: 0; }
.ver { margin: 8px 0; padding: 6px 12px; border-radius: 8px; font-size: 13px; }
table.board tr.cut > td { border-bottom: 1px solid var(--ink); }
table.board td.rk { text-align: left; padding-right: 0; }
table.board tr.us td { color: var(--green); }
table.board .side { color: var(--muted); font-size: 13px; }
table.board td.pace { font-size: 13px; white-space: nowrap; }
table.board tr.gap > td { padding: 0; }
table.board details { border: 0; margin: 0; background: none; }
table.board details > summary { padding: 2px 0; color: var(--muted); font-size: 13px; }
table.board details table { font-size: 14px; }
td.rk { width: 3.2em; text-align: right; padding-right: 10px; }
.green { background: var(--green-bg); color: var(--green); }
.amber { background: var(--amber-bg); color: var(--amber); }
.red { background: var(--red-bg); color: var(--red); }
.label { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.sub { color: var(--muted); font-size: 13px; }
.up { color: var(--green); } .down { color: var(--red); } .warn { color: var(--amber); }
.reach { margin: 0 0 6px; }
.reach > summary { padding: 10px 12px; cursor: pointer; }
.reach .pill { display: inline-block; padding: 2px 10px; border-radius: 8px; font-weight: 600; }
.reach table { width: 100%; border-collapse: collapse; margin: 0 12px 6px; width: calc(100% - 24px); }
.reach td { padding: 4px 6px; border-top: 1px solid var(--line); vertical-align: top; }
.reach .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--green); }
.reach .dot.amber { background: var(--amber); } .reach .dot.red { background: var(--red); } .reach .dot.grey { background: var(--line); }
.reach p { margin: 4px 12px; } .reach .fix { color: var(--amber); font-size: 13px; }
.reach .note { display: block; color: var(--ink); }
@media (max-width: 640px) { .reach td:last-child { display: none; } }
.kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 10px; }
.lights { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 6px; }
.light, .light.green, .light.amber, .light.red, .light.grey { background: var(--card); color: var(--ink); border: 1px solid var(--line);
  border-radius: 8px; padding: 6px 10px; min-width: 0; }
.light .label { display: flex; align-items: center; gap: 6px; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.light .label::before { content: ""; flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: var(--line); }
.light.green .label::before { background: var(--green); } .light.amber .label::before { background: var(--amber); }
.light.red .label::before { background: var(--red); }
.light .label::after { content: "ⓘ"; opacity: .5; margin-left: auto; }
.light .val { font-size: 16px; font-weight: 700; line-height: 1.2; margin-top: 1px; }
.light.amber .val { color: var(--amber); } .light.red .val { color: var(--red); }
.light .sub { font-size: 11px; overflow-wrap: anywhere; }
.light[title] { cursor: help; }
.light .bar { height: 4px; margin-top: 4px; border-radius: 3px; position: relative; overflow: hidden; background: var(--line); }
.light .bar i { position: absolute; left: 0; top: 0; bottom: 0; background: var(--muted); }
.light.blue-tile .bar i { background: var(--blue); }
.light.blue-tile.amber .val, .light.blue-tile.red .val { color: var(--ink); }   /* Blue is a track, not a red alert: the dot says how it is */
details.reach .grp { break-inside: avoid; margin: 0 0 8px; }
details.reach .cols { column-width: 22em; column-gap: 24px; padding: 0 12px 8px; }
details.reach h4 { margin: 6px 0 2px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 400; }
details.reach .r { display: grid; grid-template-columns: 12px 1fr; gap: 0 6px; padding: 2px 0; font-size: 13px; }
details.reach .r .dot { margin-top: 5px; }
details.reach .r b { font-weight: 600; }
details.reach .r .why { display: block; color: var(--muted); font-size: 12px; }
details.reach { background: none; border: 0; margin: 0 0 6px; }
details.reach > summary { display: inline-block; padding: 2px 12px; border: 1px solid var(--line); border-radius: 99px; background: var(--card);
  font-size: 12px; color: var(--muted); list-style-position: inside; }
details.reach[open] > summary { color: var(--ink); }
details.reach[open] .cols { margin-top: 6px; padding: 8px 14px 6px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
.lb { margin: 0 0 10px; padding: 8px 12px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
.lb .head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline; }
.lb table { font-size: 14px; margin-top: 2px; }
.lb td { padding: 2px 8px 2px 0; }
.lb table.board { table-layout: fixed; width: 100%; }
.lb .c-rk { width: 2.6em; } .lb .c-score { width: 5.5em; } .lb .c-pace { width: 3.8em; }
.lb table.board td:nth-child(2) { overflow-wrap: anywhere; }     /* a name with no spaces (I.use.arc.by.the.way) ran into its score */
.lb tr:first-child td { border-top: 0; }
@media (max-width: 560px) { .lights { grid-template-columns: repeat(2, 1fr); } .lights > .light.blue-tile, .lights > .light:last-child { grid-column: 1 / -1; } }
.kpi { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; min-width: 0; }
.kpi .sub { min-height: 1.4em; }
.kpi .val { font-size: 40px; font-weight: 700; line-height: 1.1; margin: 4px 0 2px; }
.kpi .sub { font-size: 14px; }
ol { list-style: none; margin: 8px 0 0; padding: 0; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
li { display: grid; grid-template-columns: 3.2em 6.5em 1fr; gap: 0 10px; padding: 8px 12px; border-top: 1px solid var(--line); }
li:first-child { border-top: 0; }
li .t { color: var(--muted); }
li .w { font-weight: 600; overflow-wrap: anywhere; }
li .w span { display: block; font-weight: 400; color: var(--muted); font-size: 13px; }
li.event, li.event .w { color: var(--muted); font-weight: 400; }
li.bad .w, li.bad .x { color: var(--red); }
li.susp { border-left: 4px solid var(--red); background: var(--red-bg); }
li.susp .w, li.susp .x { color: var(--red); font-weight: 700; }
li.hidden { border-left: 4px solid var(--ored); background: var(--ored-bg); }
li.hidden .w, li.hidden .x { color: var(--ored); }
li.deployfail { border-left: 4px solid var(--orange); background: var(--orange-bg); }
li.deployfail .w, li.deployfail .x { color: var(--orange); font-weight: 600; }
li.blue { border-left: 4px solid var(--blue); background: var(--blue-bg); }
li.blue .w, li.blue .x { color: var(--blue); }
li.susp .t, li.hidden .t, li.deployfail .t, li.blue .t { color: var(--ink); }
li.group, li.group .w { color: var(--muted); font-weight: 400; }
li details { background: none; border: 0; border-radius: 0; margin: 0; }
li summary { padding: 0; }
li details .sub { padding: 2px 0 0 1.2em; }
details.pts { margin-top: 6px; }
details.pts > summary { padding: 8px 10px; }
details.pts > div { padding: 0 10px 8px; }
details.run { border: 0; margin: 0; background: none; }
details.run > summary { padding: 0; list-style: none; display: flex; }
details.run > summary::-webkit-details-marker { display: none; }
details.plan > summary { align-items: baseline; gap: 10px; padding: 4px 0; cursor: pointer; }
details.plan .dots { flex: 0 0 auto; padding: 0 7px; border: 1px solid var(--line); border-radius: 6px; color: var(--muted);
  font-weight: 700; font-size: 18px; line-height: 1.2; }
details.plan[open] > summary .dots { background: var(--line); color: var(--ink); }
details.plan > summary .det { color: var(--ink); font-size: 14px; font-weight: 600; }
table.plan tr.today td { font-weight: 600; } table.plan tr.future td { color: var(--muted); }
table.plan td, table.plan th { padding-right: 6px; }
table.ledger td { padding: 4px 8px 4px 0; }
table.ledger td.out, details.run .out { width: 7.2em; min-width: 7.2em; flex: 0 0 7.2em; white-space: nowrap;
  font-weight: 600; }
table.ledger td.det, details.run .det { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
table.ledger table.ledger tr:first-child td { border-top: 1px solid var(--line); }
.pl { margin: 4px 0; font-size: 13px; overflow-wrap: anywhere; }
.kpis.tiles { margin: 6px 0 4px; }
.kpis.tiles .val { font-size: 22px; }
details.note { display: inline-block; border: 0; margin: 0 0 0 6px; background: none; vertical-align: middle; }
details.note > summary { padding: 0 2px; color: var(--muted); }
tr.notes { display: none; }
tr:has(details.note[open]) + tr.notes { display: table-row; }
tr.notes td { border-top: 0; padding-top: 0; }
@media (max-width: 480px) {          /* Blue by day: one stacked card per day, no sideways scroll */
  table.days, table.days tbody, table.days tr, table.days td { display: block; }
  table.days tr:first-child { display: none; }
  table.days tr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px 8px; padding: 8px 0;
    border-top: 1px solid var(--line); }
  table.days td { border: 0; padding: 0; text-align: left; }
  table.days td:first-child { grid-column: 1 / -1; font-weight: 600; }
  table.days td:empty { display: none; }
  table.days td[data-l]::before { content: attr(data-l) " "; color: var(--muted); font-size: 12px; }
}
li .x { min-width: 0; overflow-wrap: anywhere; }
li .id { color: var(--muted); font-size: 12px; }
details { background: var(--card); border: 1px solid var(--line); border-radius: 10px; margin-top: 10px; }
summary { padding: 12px; cursor: pointer; list-style-position: inside; }
summary b { margin-right: 6px; }
details > div { padding: 0 12px 12px; }
details ol { margin: 0; border: 0; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
td, th { text-align: left; padding: 5px 8px 5px 0; border-top: 1px solid var(--line); vertical-align: top; }
th { font-weight: 400; color: var(--muted); font-size: 12px; border-top: 0; }
td.num, th.num { text-align: right; }
p { margin: 8px 0; }
h3 { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 400; margin: 14px 0 4px; }
.activity { margin-top: 0; }
li.write summary { list-style-position: outside; margin-left: 1em; }
li.write details[open] > summary .lead { display: none; }
.conv { padding: 2px 0 2px; font-size: 14px; }
.conv .full { margin: 4px 0; }
.ctx { border-left: 3px solid var(--line); padding: 1px 0 1px 8px; margin: 4px 0 6px; color: var(--muted); font-size: 13px; }
.ctx .q { color: var(--ink); font-size: 14px; font-style: italic; }
.msg { border-left: 2px solid var(--line); padding: 2px 0 2px 10px; margin: 8px 0 4px; }
.msg .meta { color: var(--muted); font-size: 12px; }
.msg .meta b { color: var(--ink); font-weight: 600; }
.conv details summary { color: var(--muted); font-size: 13px; }
.conv details.clip summary { color: inherit; font-size: inherit; }
.conv details.clip[open] > summary, li details.clip[open] > summary { display: none; }
.conv details.why { margin: 4px 0; }
.conv details.why table { font-size: 13px; margin: 4px 0; }
.conv td.k, .conv th:first-child { color: var(--muted); white-space: nowrap; width: 1%; }
.note { font-size: 13px; color: var(--muted); margin: 4px 0; }
footer { margin-top: 18px; color: var(--muted); font-size: 12px; }
code { font-size: 12px; }
.fact { border-top: 1px solid var(--line); padding: 10px 0; overflow-wrap: anywhere; }
.fact.paused { border-left: 4px solid var(--red); padding-left: 10px; }
.fact p { margin: 4px 0; }
.fact .k { display: inline-block; min-width: 2.6em; color: var(--muted); font-size: 12px; text-transform: uppercase; }
.fact .q { font-style: italic; }
code.cmd { display: block; margin: 4px 0; padding: 5px 8px; background: var(--bg); border-radius: 6px;
  user-select: all; overflow-wrap: anywhere; }
@media (max-width: 560px) {          /* phone: Score across the top, Rank and Today under it; the Points tiles in a column; nothing wider than the screen */
  .kpis { grid-template-columns: 1fr 1fr; }
  .kpis > .kpi:first-child { grid-column: 1 / -1; }
  .kpi .val { font-size: 28px; } .kpis > .kpi:first-child .val { font-size: 38px; }
  .kpi { padding: 10px 12px; } .kpi .sub { font-size: 13px; }
  .kpis.tiles { grid-template-columns: 1fr; gap: 6px; }
  .kpis.tiles .kpi { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 8px 12px; }
  .kpis.tiles .val { font-size: 18px; margin: 0; }
  li { grid-template-columns: 3em 4.6em 1fr; gap: 0 6px; padding: 8px; }
  li .x, li .x * { overflow-wrap: anywhere; max-width: 100%; }
}
</style>
</head>
<body>
<main>

{% macro clip(s, n=180) %}{% if s | length > n %}<details class="clip"><summary>{{ s | short(n) }}</summary>{{ s }}</details>{% else %}{{ s }}{% endif %}{% endmacro %}

{% macro target(w) %}{% if w.target %}
<div class="ctx">{% if w.target.ours %}our post #{{ w.target.post }}{% else %}someone else{% if w.target.lean %} · leans {{ w.target.lean }}{% endif %}{% endif %}{% if w.target.source %} · from {{ w.target.source }}{% endif %}{% if w.target.context %} · under “{{ w.target.context | short(90) }}”{% endif %}
  <div class="q">{{ clip(w.target.text) }}</div></div>
{% endif %}{% endmacro %}

{% macro why(w, id) %}{% if w.why or w.rejects or w.hand or w.now %}
<details class="why" id="{{ id }}"><summary>why{% if w.why %}: {{ (w.why[:3] | map('last') | join(' · ')) }}{% endif %}{% if w.rejects %} · <span class="warn">{{ w.rejects | length }} rejected first</span>{% endif %}</summary>
  {% if w.why %}<table>{% for label, v in w.why %}<tr><td class="k">{{ label }}</td><td>{{ v }}</td></tr>{% endfor %}</table>{% endif %}
  {% if w.now %}<p class="note">Persona today: {{ w.now }}</p>{% endif %}
  {% if w.hand %}<p class="note">Typos added on purpose ({{ w.hand }}){% if w.clean %}. Clean draft: {{ w.clean }}{% endif %}</p>{% endif %}
  {% for x in w.rejects %}<p class="note warn">rejected {{ x.t | hm }}: {{ x.why }} · “{{ x.raw }}”</p>{% endfor %}
  {% if w.owner %}<p class="note">Owner: {{ w.owner }}{% if w.post %} · #{{ w.post }}{% endif %}</p>{% endif %}
</details>
{% endif %}{% endmacro %}

{% macro msg(c) %}
<div class="msg"><div class="meta">{{ c.time }} · <b>{{ c.who }}</b> {{ c.what }}</div>
  {% if c.act == 'reply_back' %}{{ target(c) }}{% endif %}
  <div>{{ clip(c.full) }}</div>
  {{ why(c, 'w' ~ c.post ~ '-why') }}
  {% for x in c.answers %}{{ msg(x) }}{% endfor %}
</div>
{% endmacro %}

{% macro convo(r) %}
<li class="write"><span class="t">{{ r.latest or r.time }}</span>
  <span class="w">{{ r.what }}<span>{{ r.who }}</span></span>
  <details class="x" id="{{ r.id }}"><summary><span class="lead">{{ r.text }} </span><span class="id">{{ r.summary }}{% if r.latest %}{{ ' · ' if r.summary }}posted {{ r.time }}{% endif %}</span></summary>
  <div class="conv">
    {% if r.parent %}<div class="ctx">our message{% if r.parent.post %} #{{ r.parent.post }}{% endif %}<div class="q">{{ clip(r.parent.text) }}</div></div>{% endif %}
    {{ target(r) }}
    <div class="full">{{ r.full }}</div>
    {{ why(r, r.id ~ '-why') }}
    {% for c in r.shown %}{{ msg(c) }}{% endfor %}
    {% if r.more %}<details class="more" id="{{ r.id }}-more"><summary>… {{ r.more | length }} more</summary>
      {% for c in r.more %}{{ msg(c) }}{% endfor %}</details>{% endif %}
    {% for x in r.answers %}{{ msg(x) }}{% endfor %}
    {% if r.reposts or r.likes or r.plan or r.measures %}
    <details class="why" id="{{ r.id }}-amp"><summary>amplification{% if r.plan %}: {{ r.plan.level }}{% endif %}</summary>
      <table>
        <tr><th></th><th class="num">likes</th><th class="num">replies</th><th class="num">reposts</th></tr>
        {% if r.plan %}<tr><td class="k">planned</td><td class="num">{{ r.plan.likes | n }}</td><td class="num">{{ r.plan.replies | n }}</td><td class="num">{{ r.plan.reposts | n }}</td></tr>{% endif %}
        <tr><td class="k">ours so far</td><td class="num">{{ (r.likes or 0) | n }}</td><td class="num">{{ r.children | length }}</td><td class="num">{{ (r.reposts or []) | length }}</td></tr>
      </table>
      {% if r.reposts %}<p class="note">Reposted by {{ r.reposts | join(', ') }}</p>{% endif %}
      {% if r.measures %}<table>
        <tr><th>result</th><th class="num">citizen likes</th><th class="num">citizen replies</th><th class="num">views not ours</th><th class="num">best rank</th></tr>
        {% for m in r.measures %}{% if m.gone %}<tr><td class="k">{{ m.at }}</td><td colspan="4" class="down">hidden or gone ({{ m.gone }})</td></tr>
        {% else %}<tr><td class="k">{{ m.at }}</td><td class="num">{{ m.citizen_likes | n }}</td><td class="num">{{ m.citizen_replies | n }}</td><td class="num">{{ m.views | n }}</td><td class="num">{{ ('#' ~ m.rank) if m.rank else '—' }}</td></tr>{% endif %}{% endfor %}
      </table>{% else %}<p class="note">Measured at +1 h and +6 h.</p>{% endif %}
    </details>
    {% endif %}
  </div></details></li>
{% endmacro %}

{% macro item(r) %}
{% if r.kind == 'write' %}{{ convo(r) }}{% else %}
<li class="{{ r.kind }}"><span class="t">{{ r.time }}</span>
  <span class="w">{{ r.what }}{% if r.who %}<span>{{ r.who }}</span>{% endif %}</span>
  {% if r.kind == 'group' %}
  <details class="x" id="{{ r.id }}"><summary>{{ r.text }}</summary>
    {% for s in r.rows %}<div class="sub">{{ s.time }} · {{ s.text }}</div>{% endfor %}</details>
  {% elif r.detail %}
  <details class="x" id="{{ r.id }}"><summary>{{ r.text }}</summary>
    {% for t, x in r.detail %}<div class="sub">{{ t }} · {{ x }}</div>{% endfor %}</details>
  {% elif r.text | length > 200 %}
  <details class="x clip"><summary>{{ r.text | short(200) }}</summary>{{ r.text }}</details>
  {% else %}
  <span class="x">{{ r.text }}{% if r.post %} <span class="id">#{{ r.post }}</span>{% endif %}</span>
  {% endif %}</li>
{% endif %}
{% endmacro %}

<header><b>SWAN</b>
  <span class="chips"><span class="chip {{ banner.level }}" title="Red track: the bot">Red</span><span class="chip {{ blue_banner.level }}" title="Blue track: reporting">Blue</span>{% if running %}<span class="chip {{ running.light }}" title="running version, deployed {{ running.when }}">{{ running.sha }} · {{ running.when }}</span>{% endif %}</span></header>
<div class="sub" style="text-align:right">as of {{ now }} Perth</div>
<div class="alerts">
  {% if banner.level != 'green' %}<p class="{{ banner.level }}"><b>Red</b> · {{ banner.text }}</p>{% endif %}
  {% if blue_banner.level != 'green' %}<p class="{{ blue_banner.level }}"><b>Blue</b> · {{ blue_banner.text }}</p>{% endif %}
  {% if draft_banner.level != 'green' %}<details class="{{ draft_banner.level }}"><summary><b>Drafting</b> · {{ draft_banner.summary }}</summary>{% for l in draft_banner.detail %}<div>{{ l }}</div>{% endfor %}</details>{% endif %}
  {% if running and running.failed %}<p class="red"><b>Deploy failed {{ running.failed }}</b>, still on v{{ running.sha }}</p>{% endif %}
</div>
{% if rollback %}<div class="ver red">Roll back to the last stable version (pauses auto-deploy; restart it with <code>sudo systemctl start swan-update.timer</code> after pushing a fix):<code class="cmd">{{ rollback }}</code></div>{% endif %}

<div class="kpis">
  <div class="kpi"><div class="label">Score</div>
    <div class="val">{{ score.points | n if score else '—' }}</div>
    <div class="sub">{% if not score %}not entered yet{% elif score.by == 'portal' and portal_checked %}portal · checked {{ portal_checked }}{% else %}entered {{ score.ago }}{% endif %}</div></div>
  <div class="kpi"><div class="label">Rank</div>
    <div class="val">{{ ('#' ~ score.rank) if score and score.rank else '—' }}</div>
    <div class="sub">{% if score and score.teams %}of {{ score.teams }}{% endif %}{% if board and board.above %} · {{ (board.above.score - board.score) | n }} behind #{{ board.above.rank }}{% endif %}</div></div>
  <div class="kpi"><div class="label">Today</div>
    {% if score and score.delta is not none %}
    <div class="val {{ 'up' if score.delta >= 0 else 'down' }}">{{ '+' if score.delta >= 0 else '' }}{{ score.delta | n }}</div>
    <div class="sub">{% if score.last_hour is not none %}{{ '%+d' % score.last_hour }} at {{ score.last_hour_at }}{% elif score.per_hour is not none %}≈ {{ score.per_hour | n }} pts/hour{% endif %} · since {{ day_start }}</div>
    {% else %}<div class="val">—</div><div class="sub">since {{ day_start }}</div>{% endif %}</div>
</div>

<div class="lights">
{% for i in reach.lights %}
  <div class="light {{ i.light }}{{ ' blue-tile' if i.key == 'blue' }}" title="{{ i.tip }}"><div class="label">{{ i.name }}</div><div class="val">{{ i.head }}</div><div class="sub">{{ i.sub }}</div>{% if i.fill is not none and i.key == 'blue' %}<div class="bar"><i style="width:{{ (i.fill * 100) | round | int }}%"></i></div>{% endif %}</div>
{% endfor %}
</div>
<details class="reach" id="reach">
  <summary>Details</summary>
  <div class="cols">
  {% for i in reach.lights if i.key != 'blue' and (i.rows | length) %}
    <div class="grp"><h4>{{ i.name }}</h4>
    {% for r in i.rows %}
      <div class="r" title="{{ r.target }}"><span class="dot {{ r.light }}"></span><span>{{ r.name }}: <b>{{ r.now }}</b>{% if r.light in ('amber', 'red') %}<span class="why">{% if r.target %}aim: {{ r.target }}{% endif %}{% if r.fix %}{{ ' · ' if r.target }}{{ r.fix }}{% endif %}{% if r.note %} · in hand: {{ r.note }}{% endif %}</span>{% endif %}</span></div>
    {% endfor %}</div>
  {% endfor %}
  {% if pool and pool.acts %}<div class="grp"><h4>Pool, last actions</h4>{% for a in pool.acts %}<div class="r"><span></span><span class="sub">{{ a.when }} · {{ a.act }}{% if a.username %} · @{{ a.username }}{% endif %}</span></div>{% endfor %}</div>{% endif %}
  </div>
  {% for x in reach.extra %}<p class="sub" style="margin:0 12px 8px">{{ x }}</p>{% endfor %}
</details>

{% macro tone(d) %}{{ 'down' if d and d > 0 else 'up' if d and d < 0 }}{% endmacro %}
{% macro pace(r) %}{% if board.pace %}<td class="num pace {{ tone(r.pace_vs_us) }}">{{ r.pace | rate }}</td>{% endif %}{% if board.pace_now %}<td class="num pace {{ tone(r.pace_now_vs_us) }}">{{ r.pace_now | rate }}</td>{% endif %}{% endmacro %}
{% macro cols() %}<colgroup><col class="c-rk"><col><col class="c-score">{% if board.pace %}<col class="c-pace">{% endif %}{% if board.pace_now %}<col class="c-pace">{% endif %}</colgroup>{% endmacro %}
{% macro row(r) %}<tr><td class="rk">#{{ r.rank }}</td><td>{{ r.team }} <span class="side">{{ r.side }}</span></td><td class="num">{{ r.score | n }}</td>{{ pace(r) }}</tr>{% endmacro %}
{% if board %}
{% set width = 3 + (1 if board.pace else 0) + (1 if board.pace_now else 0) %}
<div class="lb" id="leaderboard">
  <div class="head"><span class="label">Leaderboard</span>
    <span class="sub">{% if board.cutoff is not none %}{{ board.cutoff | n }} behind #3{% elif board.rank <= 3 %}<span class="up">in the top three</span>{% endif %} · top 3 go to Sydney{% if board.trend %} · {% if board.trend.windows %}{% for w in board.trend.windows %}{{ ' · ' if not loop.first }}<span class="{{ 'up' if w.change < 0 else 'down' if w.change > 0 }}" title="us {{ '{:+,d}'.format(w.us) }}, #3 {{ '{:+,d}'.format(w.them) }} in {{ w.hours }} h">{{ 'closing' if w.change < 0 else 'widening' if w.change > 0 else 'level' }}{% if w.change %} {{ w.change | abs | n }}{% endif %} in {{ w.hours }} h</span>{% endfor %}{% else %}gap history building ({{ board.trend.points }} point{{ 's' if board.trend.points != 1 }}){% endif %}{% endif %}</span></div>
  <table class="board">{{ cols() }}
    {% if board.pace or board.pace_now %}<tr class="sub"><td colspan="3" class="num">pts/h, last</td>{% for p in (board.pace, board.pace_now) if p %}<td class="num" title="points an hour over the last {{ p.span | round | int }} h, up to the board change at {{ p.as_of_label }}{% if p.scaled %}, the hours earned at a lower multiplier scaled up to the ×{{ p.mult }} in force now{% endif %}; red = gaining on us, green = we are gaining on them">{{ p.span | round | int }} h{% if p.scaled %} at ×{{ p.mult }}{% endif %}</td>{% endfor %}</tr>{% endif %}
    {% for r in board.finalists %}<tr class="{{ 'us' if r.us }}{{ ' cut' if loop.last }}"><td class="rk">#{{ r.rank }}</td><td>{{ r.team if not r.us else 'Operation Swan (us)' }} <span class="side">{{ r.side }}</span></td><td class="num">{{ r.score | n }}</td>{{ pace(r) }}</tr>
    {% endfor %}
    {% if board.gap %}<tr class="gap"><td colspan="{{ width }}">{% if board.between %}<details><summary>{{ board.between | length }} more team{{ 's' if board.between | length > 1 }}</summary>
      <table class="board">{{ cols() }}{% for r in board.between %}{{ row(r) }}{% endfor %}</table></details>{% else %}<span class="sub">…</span>{% endif %}</td></tr>{% endif %}
    {% for r in board.near %}<tr class="{{ 'us' if r.us }}"><td class="rk">#{{ r.rank }}</td><td>{{ r.team }} <span class="side">{{ r.side }}</span></td><td class="num">{{ r.score | n }}</td>{{ pace(r) }}</tr>
    {% endfor %}
    {% if board.fourth %}{{ row(board.fourth) }}{% endif %}
    {% if board.rest %}<tr class="gap"><td colspan="{{ width }}"><details id="lb-rest"><summary>#{{ board.rest[0].rank }}{% if board.rest | length > 1 %}–#{{ board.rest[-1].rank }}{% endif %}</summary>
      <table class="board">{{ cols() }}{% for r in board.rest %}{{ row(r) }}{% endfor %}</table></details></td></tr>{% endif %}
  </table>
</div>
{% endif %}

<details id="activity"><summary><b>Activity</b><span class="sub">{{ activity | length }}{% if older %} + {{ older | length }} older critical{% endif %} · newest {{ activity[0].time if activity and activity[0].time }}</span></summary>
<ol class="activity">
{% for r in activity %}
  {{ item(r) }}
{% else %}
  <li class="event"><span class="t"></span><span class="w"></span><span class="x">Nothing logged yet.</span></li>
{% endfor %}
</ol>
{% if older %}
<details id="older"><summary><b>Older critical events</b><span class="sub">{{ older | length }}</span></summary>
<ol>
{% for r in older %}
  {{ item(r) }}
{% endfor %}
</ol></details>
{% endif %}
</details>

<details id="bot"><summary><b>Bot</b><span class="sub">
  {% if llm.busiest %}{{ llm.busiest.model }} ({{ llm.busiest.calls | n }} calls today){% else %}{{ llm.model or 'no LLM' }}{% endif %} ·
  {% if bans %}{{ bans.left }} left · {{ bans.text }}{% if acct_days and acct_days[0].today and acct_days[0].new > 0 %} · +{{ acct_days[0].new }} today{% endif %}{% else %}{{ accounts.live | n }}/{{ accounts.live_cap }} accounts{% endif %} · {{ accounts.voices | n }} {{ accounts.voices | pl('voice') }}{% if hot %} (hot){% endif %}
  {% if errors.rate_limited %} · {{ errors.rate_limited }} rate-limited{% endif %}</span></summary>
<div>
  <h3>LLMs</h3>
  <table>
  {% for m in llm.chain %}
    <tr><td>{{ loop.index }}. {{ m.model }}</td><td>{{ m.calls | n }} today</td><td class="{{ 'warn' if m.out else '' }}">{{ m.state }}</td></tr>
  {% else %}<tr><td class="sub">No status from the bot yet.</td></tr>{% endfor %}
  </table>
  <h3>Accounts</h3>
  {% if bans %}<p><b>{{ bans.left }} left · {{ bans.text }} · {{ bans.registered }} registered{% if portal_accounts %} · {{ portal_accounts.max_active }} active max{% endif %}</b> <span class="sub">(the portal)</span> · {{ accounts.voices | n }} {{ accounts.voices | pl('voice') }}{% if hot %} (hot){% endif %} · {{ accounts.boosters | n }} {{ accounts.boosters | pl('booster') }}</p>
  {% else %}<p>{{ accounts.live | n }} live of {{ accounts.live_cap }} ({{ accounts.voices | n }} {{ accounts.voices | pl('voice') }}{% if hot %} (hot){% endif %}, {{ accounts.boosters | n }} {{ accounts.boosters | pl('booster') }}) · {{ accounts.suspended | n }} suspended</p>{% endif %}
  <details id="acct-days"><summary><b>Accounts by day</b><span class="sub">{% if acct_days %}{{ acct_days | length }} days{% endif %}</span></summary>
  <div>{% if forecast %}
  <details class="run plan" id="acct-plan"><summary><span class="dots" title="show the days">⋮</span><span class="det">{{ forecast.summary }}</span></summary>
  <table class="days plan">
    <tr><th>Day (9pm–9pm Perth)</th><th class="num">New bans</th><th class="num">Forecast</th><th class="num">Net</th><th class="num">Banned</th><th class="num">Path</th><th class="num">vs path</th><th class="num">Left</th><th>Why</th></tr>
    {% for d in forecast.rows %}<tr class="{{ 'today' if d.today }}{{ ' future' if d.future }}"><td>{{ d.day }}{% if d.today %} (so far){% endif %}{% if d.planned %}<br><span class="sub">×{{ d.mult }} · {{ d.planned | round | int | n }} writes ({{ d.src }})</span>{% endif %}</td>
      <td class="num {{ 'down' if d.actual else '' }}" data-l="new bans">{% if d.actual is not none %}{{ '+' if d.actual > 0 }}{{ d.actual }}{% endif %}</td>
      <td class="num" data-l="forecast">{{ '%.1f' % d.forecast if d.forecast is not none }}</td>
      <td class="num {{ d.level }}" data-l="net"{% if d.tol is not none %} title="within ±{{ d.tol }} counts as on forecast"{% endif %}>{% if d.net is not none %}{{ d.net | signed }} <span class="sub">±{{ d.tol }}</span>{% endif %}</td>
      <td class="num" data-l="banned">{% if d.banned is not none %}{{ '≈' if d.est }}{{ d.banned }}{% endif %}</td>
      <td class="num" data-l="path">{{ d.path | round | int if d.path is not none }}</td>
      <td class="num {{ 'down' if d.over is not none and d.over > 0 else 'up' if d.over is not none and d.over < 0 }}" data-l="vs path">{% if d.over is not none %}{{ d.over | signed }}{% endif %}</td>
      <td class="num" data-l="left">{% if d.left is not none %}{{ '≈' if d.est }}{{ d.left }}{% if d.goal_delta is not none %} <span class="{{ 'up' if d.goal_delta >= 0 else 'down' }}">{{ d.goal_delta | signed }} <span class="sub">of {{ forecast.goal | round | int }}</span></span>{% endif %}{% endif %}</td>
      <td class="sub">{{ d.why }}{% if d.unnamed %}{{ ' · ' if d.why }}<span class="warn">{{ d.unnamed }} not named yet</span>{% endif %}</td></tr>{% endfor %}
  </table>
  <p class="sub">Accounts left = not banned = alive + not yet registered = 200 − banned; the benchmark is {{ forecast.goal | round | int }} left at the end of {{ forecast.goal_day }}. Forecast = planned writes ÷ {{ forecast.wpb | round | int }} writes per ban ({{ forecast.wpb_src }}); planned writes are <code>BAN_PLAN</code> in config.py (a day without one: its actual writes, or the last 3 days' average). Path is <code>BAN_PATH</code>, the banned total to steer by (days between its entries are in a straight line). Banned and left are end of day: actual to yesterday, forecast from today (≈), starting from the count now so today's overshoot carries on. Net is bans so far against the forecast for the part of the day gone, plus or minus 1.5 standard deviations (at least 2).</p>
  </details>
  {% for a in forecast.alerts %}<p class="sub warn">{{ a }}</p>{% endfor %}
  {% elif acct_days %}<table>
    <tr><th>Day (9pm–9pm Perth)</th><th class="num">Registered</th><th class="num">Banned</th><th class="num">New bans</th><th>Why</th></tr>
    {% for d in acct_days %}<tr><td>{{ d.day }}{% if d.today %} (so far){% endif %}</td><td class="num">{{ d.registered }} <span class="sub">{{ '+' if d.new_reg > 0 }}{{ d.new_reg }}</span></td><td class="num">{{ d.banned }}</td><td class="num {{ 'down' if d.new > 0 else '' }}">{{ '+' if d.new > 0 }}{{ d.new }}</td><td class="sub">{{ d.why }}{% if d.unnamed %}{{ ' · ' if d.why }}<span class="warn">{{ d.unnamed }} not named yet</span>{% endif %}</td></tr>{% endfor %}
  </table>{% endif %}
  {% if acct_days %}{% for x in banned_list %}<p class="pl"><span class="sub">{{ x.time }}</span> @{{ x.username }} <span class="sub">#{{ x.id }} · {{ x.why }}</span></p>{% endfor %}
  {% else %}<p class="sub">No history yet: it fills at the next portal read (every 15 min).</p>{% endif %}
  </div></details>
  <h3>Last hour</h3>
  <p>{{ writes.hour }} writes{% if writes.planned %} (bot's pace {{ writes.planned }}, team cap {{ writes.cap }}){% endif %} ·
    {{ errors.rate_limited | n }} rate-limited · {{ errors.rejects }} drafts rejected by our quality check</p>
</div></details>

<details id="score"><summary><b>Score &amp; targets</b><span class="sub">
  {% if milestone %}{{ milestone.name }} {{ 'today' if milestone.today else milestone.date }}:
    {% if milestone.reached %}<span class="up">✓ reached</span>{% elif milestone.short is not none %}<span class="warn">{{ milestone.short | n }} to go</span>{% else %}needs {{ milestone.need | n }}{% endif %} · {% endif %}
  ×{{ multiplier.now }} now{% if score_lines.rows %} · {{ '+' if score_lines.total >= 0 }}{{ score_lines.total | n }} since {{ day_start }}{% endif %}</span></summary>
<div>
  <h3>Points since {{ day_start }}</h3>
  <div class="kpis tiles">{% for k in score_lines.tiles %}<div class="kpi"><div class="label">{{ k.name }}</div>
    <div class="val {{ 'up' if k.points > 0 else ('down' if k.points < 0 else '') }}">{{ '≈' if k.mixed }}{{ '+' if k.points > 0 }}{{ k.points | n }}</div></div>{% endfor %}</div>
  {% if score_lines.rows %}<p class="sub">Total {{ '+' if score_lines.total >= 0 }}{{ score_lines.total | n }}, from the portal's log. It gives one total an hour; where an hour mixes kinds the split (≈) is ours: Blue by its report counts, the rest by the scoring guide's values.</p>{% endif %}
  {% if milestone %}<p>{{ milestone.name }} ({{ milestone.date }}): leading-side teams with at least {{ milestone.need | n }} points get the award.</p>{% endif %}
  <p>Red multiplier ×{{ multiplier.now }}{% if multiplier.next %}, ×{{ multiplier.next }} from {{ multiplier.date }} (in {{ multiplier.left }}; our estimate, not confirmed){% endif %}.</p>
  {% if history %}
  <h3>Our score over time</h3>
  <table>
    <tr><th>When (Perth)</th><th class="num">Score</th><th class="num">Change</th><th class="num">Rank</th></tr>
    {% for h in history %}
    <tr><td>{{ h.time }}{% if h.notes %}<details class="note" id="score-{{ h.time | replace(' ', '-') | replace(':', '') }}"><summary></summary></details>{% endif %}</td><td class="num">{{ h.score | n }}</td>
      <td class="num {{ 'up' if h.change and h.change > 0 else ('down' if h.change and h.change < 0 else '') }}">{% if h.change is not none %}{{ '+' if h.change >= 0 else '' }}{{ h.change | n }}{% endif %}</td>
      <td class="num">{{ h.rank | n }}</td></tr>
    {% if h.notes %}<tr class="notes"><td colspan="4">{% for x in h.notes %}<p class="pl"><span class="sub">{{ x.time }}</span> <b>{{ '+' if x.points >= 0 }}{{ x.points | n }}</b> {{ x.text }}</p>{% endfor %}</td></tr>{% endif %}
    {% endfor %}
  </table>
  {% endif %}
  <p class="sub">Read from the portal every 15 minutes{% if portal_checked %} (last check {{ portal_checked }}){% endif %}. By hand if needed: <code>ssh swan-ec2 'ctn/scripts/score.sh &lt;score&gt; &lt;rank&gt; &lt;teams&gt; &lt;name&gt;'</code></p>
</div></details>

<details id="blue"><summary><b>Blue</b><span class="sub {{ 'warn' if blue and (blue.stale or blue.waiting) else '' }}">
  {% if blue %}{{ blue.summary }}{% else %}not running{% endif %}</span></summary>
<div>
  {% if blue %}
  {% if blue.waiting %}
  <p><b>{{ blue.waiting }} reports ready</b> from {{ blue.rings | length }} ring{{ 's' if blue.rings | length > 1 }} ({{ blue.teams }} team{{ 's' if blue.teams > 1 }}), expected to earn about {{ blue.ev | n }} points. Every one is a post by a team account (registered after launch, not ours) inside a ring:</p>
  <table>
    <tr><th>Ring</th><th>Evidence</th><th class="num">Reports</th></tr>
    {% for r in blue.rings %}<tr><td>{{ ('#' ~ r.post) if r.post else 'account' }}</td><td>{{ r.why }}</td><td class="num">{{ r.reports }}</td></tr>{% endfor %}
  </table>
  <code class="cmd">{{ blue.approve }}</code>
  {% endif %}
  {% if blue.own %}<p class="{{ 'down' if blue.own.hits else 'sub' }}">Own accounts reported: <b>{{ blue.own.hits }}</b></p>
  {% else %}<p class="sub warn">Own accounts reported: not checked yet</p>{% endif %}
  {% if blue.spread %}<p class="sub">{{ blue.spread }}</p>{% endif %}
  {% if blue.history %}<details id="blue-days"><summary>By competition day (each runs 9pm–9pm Perth)</summary>
  <table class="days"><tr><th>Day</th><th class="num">Points</th><th class="num">Target</th><th class="num">Sent</th><th class="num">Posts hidden</th><th class="num">Posts genuine</th><th class="num">Accounts ruled</th><th class="num">Pending</th><th class="num">1st reporter</th><th class="num">Full pay</th><th class="num">Reduced</th><th class="num">Locked</th></tr>
  {% for d in blue.history %}<tr><td>{{ d.day }}{% if d.today %} (so far){% endif %}</td><td class="num" data-l="points">{{ d.points | n }}</td><td class="num {{ '' if d.today else d.level }}" data-l="of target">{{ d.pct }}%</td><td class="num" data-l="sent">{{ d.filed }}</td><td class="num" data-l="posts hidden">{{ d.hidden }}</td><td class="num" data-l="posts genuine">{{ d.genuine }}</td><td class="num" data-l="accounts ruled">{{ d.accounts }}</td><td class="num" data-l="pending">{{ d.pending }}</td><td class="num" data-l="1st reporter">{{ d.first }}/{{ d.paid }}</td><td class="num" data-l="full pay">{{ d.full }}/{{ d.awards }}</td><td class="num {{ d.reduced_level }}" data-l="paid reduced">{{ (d.reduced ~ '%') if d.reduced is not none else '–' }}</td><td class="num" data-l="locked">{{ d.locked_h }} h</td></tr>{% endfor %}
  </table></details>{% endif %}
  {% if blue.timeline %}<details id="blue-ledger"><summary>Reports since {{ day_start }}: <span class="up">{{ blue.counts.success }} successful</span> · <span class="{{ 'down' if blue.counts.failed else '' }}">{{ blue.counts.failed }} failed</span> · <span class="{{ 'warn' if blue.counts.pending else '' }}">{{ blue.counts.pending }} pending</span></summary>
  <table class="ledger">{% for it in blue.timeline %}{% if it.kind == 'run' %}<tr><td colspan="2"><details class="run" id="{{ it.id }}"><summary><span class="out {{ it.css }}">▸ {{ it.out }}</span><span class="det">{{ it.detail }}</span></summary>
    <table class="ledger">{% for r in it.rows %}<tr><td class="out {{ r.css }}">{{ r.out }}</td><td class="det">{{ r.detail }}</td></tr>{% endfor %}</table></details></td></tr>
  {% else %}<tr><td class="out {{ it.css }}">{{ it.out }}</td><td class="det">{{ it.detail }}</td></tr>{% endif %}{% endfor %}</table>
  <p class="sub">Groups are accounts acting together, as swan-blue clusters them; not the organisers' team numbers.</p>
  </details>{% endif %}
  {% if blue.error %}<p class="sub warn">{{ blue.error | capitalize }}.</p>{% endif %}
  {% else %}<p class="sub">swan-blue hasn't written a status yet.</p>{% endif %}
</div></details>

<details id="facts"><summary><b>Facts</b><span class="sub {{ 'down' if facts and (facts.paused or facts.auto.problems) else '' }}">
  {% if facts %}{% if facts.paused %}{{ facts.paused | length }} paused · {% endif %}{% if facts.auto.problems %}{{ facts.auto.problems | length }} problem{{ 's' if facts.auto.problems | length != 1 }} · {% endif %}{{ facts.auto.log | rejectattr('reverted') | list | length }} recently added{% else %}fact desk not set up{% endif %}</span></summary>
<div>
  {% if facts %}
  {% for p in facts.paused %}<p class="down"><b>Paused: {{ p.fact }}</b> since {{ p.since }}{% if p.paper %} ({{ p.paper }}){% endif %}. {{ p.text }}</p>{% endfor %}
  {% for x in facts.auto.problems %}<p class="down"><b>{{ x | capitalize }}</b></p>{% endfor %}
  <h3>Recently added ({{ facts.auto.log | rejectattr('reverted') | list | length }})</h3>
  {% for d in facts.auto.log %}
  <div class="fact"><p><span class="sub">{{ d.date }}</span> {% if d.reverted %}<s>{{ d.text }}</s> <span class="sub">(reverted)</span>{% else %}{{ d.text }}{% endif %}
    <span class="sub">· {% if d.url %}<a href="{{ d.url }}" rel="noreferrer noopener" target="_blank">{{ d.paper }}</a>{% else %}{{ d.paper }}{% endif %}</span></p>
    {% if not d.reverted %}<code class="cmd">{{ d.undo }}</code>{% endif %}</div>
  {% else %}<p class="sub">None yet: the desk checks the papers every hour and adds what they report.</p>{% endfor %}
  {% endif %}
</div></details>

<p class="sub" id="pulse">Trending pulse (what the bot's amplified posts lean on):
  {% if pulse %}<span class="{{ 'warn' if pulse.stale else '' }}">updated {{ pulse.ago }}{% if pulse.stale %} (too old: not used){% endif %}</span>, from Trending #{{ pulse.id }}: {{ pulse.hooks | length }} hook{{ 's' if pulse.hooks | length != 1 }}, {{ pulse.no_shapes | length }} for No, {{ pulse.yes_lines | length }} Yes line{{ 's' if pulse.yes_lines | length != 1 }}, {{ pulse.avoid | length }} overused{% if pulse.hooks %}; first hook “{{ pulse.hooks[0] | short(80) }}”{% endif %}.{% if pulse.worries %} From {{ pulse.citizens }} citizen posts, their worries: {% for w in pulse.worries %}{{ '; ' if not loop.first }}“{{ w }}”{% endfor %}{% if pulse.rising %}; rising: {% for r in pulse.rising %}{{ ', ' if not loop.first }}“{{ r }}”{% endfor %}{% endif %}.{% endif %}
  {% else %}none logged yet.{% endif %}</p>

<footer>Times are Perth (AWST). The competition day rolls over at {{ day_start }} Perth. Page built {{ built }}, refreshes every minute.</footer>

</main>
</body>
</html>
