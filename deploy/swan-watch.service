[Unit]
Description=Hidden-post watch and hourly ring self-audit (scripts/swan_watch.py): read-only

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/ctn
ExecStart=/home/ec2-user/ctn/.venv/bin/python scripts/swan_watch.py
# Peak 79 MB on a 650k-line log (66 MB of it imports): ~4x
MemoryMax=300M
TimeoutStartSec=15min
