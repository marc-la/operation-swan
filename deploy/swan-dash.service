[Unit]
Description=Build the team dashboard page (todo/09)

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/ctn/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ec2-user/ctn/.venv/bin/python -m swan_dash.build --out /var/www/swan
# Sandbox: no network, the secrets are invisible, and the only writable place is the web root.
PrivateNetwork=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/swan
InaccessiblePaths=-/home/ec2-user/ctn/.env -/home/ec2-user/ctn/secrets -/home/ec2-user/.ssh
