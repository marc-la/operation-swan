[Unit]
Description=Citizen scan (scripts/npc_scan.py): read-only, paced, scores accounts above id 2343 into data/npc_scores.json (todo/48)

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/ctn
ExecStart=/usr/bin/flock -n /tmp/swan-npcscan.lock /home/ec2-user/ctn/.venv/bin/python scripts/npc_scan.py
Nice=19
MemoryMax=400M
# --max 400 accounts at 40 reads a minute is about 20 min; the cap is only a backstop
TimeoutStartSec=1h
