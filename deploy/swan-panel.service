[Unit]
Description=The panel (scripts/panel.py, todo/52 WS2): read-only, writes data/panel.json for the dashboard's Room tile

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/ctn
Nice=19
ExecStart=/home/ec2-user/ctn/.venv/bin/python scripts/panel.py --json data/panel.json --quiet
# streams logs/swan_actions.jsonl (jsonl.Reader): 3 s and 49 MB on the box on 29 Oct (300 MB log)
MemoryMax=300M
TimeoutStartSec=10min
